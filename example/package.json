{
  "name": "react-native-paper-example",
  "version": "0.0.1",
  "description": "Example for React Native Paper",
  "author": "",
  "private": true,
  "scripts": {
    "eas-build-pre-install": "cd .. && yarn",
    "start": "EXPO_NO_TYPESCRIPT_SETUP=1 expo start --dev-client",
    "android": "EXPO_NO_TYPESCRIPT_SETUP=1 expo run:android",
    "ios": "EXPO_NO_TYPESCRIPT_SETUP=1 expo run:ios",
    "visual": "node visual/run.mjs",
    "test:visual": "node --test visual/run.test.mjs"
  },
  "dependencies": {
    "@expo/metro-config": "~58.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^8.0.0-alpha.57",
    "@react-navigation/drawer": "^8.0.0-alpha.58",
    "@react-navigation/elements": "3.0.0-alpha.55",
    "@react-navigation/native": "^8.0.0-alpha.51",
    "@react-navigation/native-stack": "^8.0.0-alpha.59",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-keep-awake": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "babel-preset-expo": "~58.0.24",
    "react-native-builder-bob": "^0.42.1",
    "react-native-monorepo-config": "^0.4.0"
  },
  "engines": {
    "node": ">=20"
